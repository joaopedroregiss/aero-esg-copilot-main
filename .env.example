USE_MOCK_AI=true

# Chave da API do Gemini (Google AI Studio). Necessária quando USE_MOCK_AI=false.
GEMINI_API_KEY=

# Mantido por compatibilidade com o provedor Anthropic opcional (lib/ai/anthropicProvider.ts).
AI_API_KEY=

# Banco de dados: Supabase (Postgres).
# 1. Crie um projeto em https://supabase.com/dashboard (free tier).
# 2. Em Project Settings -> API, copie a "Project URL" e a "service_role" key.
# 3. Rode supabase/migrations/0001_create_ideas.sql no SQL Editor do projeto
#    (Project -> SQL Editor -> New query -> cole o conteudo do arquivo -> Run).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
